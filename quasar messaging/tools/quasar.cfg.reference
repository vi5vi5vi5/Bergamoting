 },
 "fluent-bitd": {
  "Logging": {
   "file": {
    "enabled": true,
    "fileName": "${LOGS}/fluent-bitd.log",
    "maxBackupIndex": 1,
    "maxFileSize": "10KB"
   },
   "level": "info"
  },
  "Minidump": {
   "enabled": true,
   "fileName": "minidump/fluent-bitd.dmp",
   "moveToMetrica": true,
   "sizeLimitKB": 200
  },
  "collectMetricsPeriodMs": 300000,
  "fluent-bit": {
   "enabled": true,
   "tailPaths": [
    "${LOGS}/*.log",
    "/var/log/messages"
   ],
   "variables": {
    "clickdaemonHost": "clck.yandex.net",
    "clickdaemonPort": "443",
    "clickdaemonUri": "/quasar/write/json/batch",
    "daemonsLogsDst": "http",
    "flushInterval": "60",
    "httpCompress": "gzip",
    "httpIPv6": "Off",
    "httpListen": "127.0.0.1",
    "httpRetryLimit": "5",
    "httpServer": "Off",
    "httpServerPort": "10001",
    "httpTls": "On",
    "httpWorkers": "2",
    "ipcLogsDst": "none",
    "keepAliveMaxRecycle": "2000",
    "keepAliveTimeout": "30",
    "kernelLogsDst": "none",
    "logcatDst": "none",
    "logcatLogBufferSize": "1048576",
    "memBufLimit": "1m",
    "stdout": "Off",
    "stdoutMatch": "none",
    "tailBufferChunkSize": "32k",
    "tailBufferMaxSize": "32k",
    "tailDbFile": "${TMP}/fluent-bit.db",
    "tailSkipLongLines": "On"
   }
  },
  "port": 9832,
  "selfDestroyer": {
   "memoryLimitRssKB": 55000
  }
 },
 "glagold": {
  "Logging": {
   "file": {
    "enabled": true,
    "fileName": "${LOGS}/glagold.log",
    "maxBackupIndex": 1,
    "maxFileSize": "10KB"
   },
   "level": "info"
  },
  "Minidump": {
   "enabled": true,
   "fileName": "minidump/glagold.dmp",
   "moveToMetrica": true,
   "sizeLimitKB": 200
  },
  "deviceCacheFile": "${DATA}/devices.json",
  "disabled": false,
  "enableEndpointProtocol": true,
  "externalPort": 1961,
  "hostnamePrefix": "YandexMini3-",
  "port": 9899,
  "servicePrefix": "YandexIOReceiver-",
  "serviceType": "_yandexio._tcp",
  "tokensStorage": "${DATA}/gsdkTokens.json"
 },
 "http_client": {
