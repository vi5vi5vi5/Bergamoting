 },
 "audioclient": {
  "controller": {
   "audioStorage": {
    "storageHistory": "${DATA}/audioStorageHistory.json",
    "storagePath": "${TMP}"
   },
   "cleanPlayerTimeoutSeconds": 1800,
   "cleanPlayersPeriodSeconds": 300,
   "http_client": {
    "connectionTimeoutMs": 4000,
    "timeoutMs": 600000
   },
   "mediaCacheConfig": {
    "cacheDirectory": "${TMP}/MediaCache"
   },
   "mediaCacheEnabled": false,
   "playbackParams": {
    "AUDIO_FILE": {
     "gstPipeline": "{FILESRC} ! {DECODEBIN} ! {AUDIOCONVERT} ! {AUDIORESAMPLE} ! {CAPS_STEREO} ! {VOLUME_MASTER} ! {SINK}"
    },
    "BLUETOOTH_STREAM": {
     "gstPipeline": "{BLUETOOTHSRC} ! {QUEUE2} ! {AUDIOCONVERT} ! {AUDIORESAMPLE} ! {CAPS_STEREO} ! {VOLUME_MASTER} ! {VOLUME_EQUALIZER} ! {SINK} sync=false",
     "gstProperties": {
      "QUEUE2": {
       "": "queue2",
       "max-size-buffers": 0,
       "max-size-bytes": 200000,
       "max-size-time": 0
      }
     }
    },
    "OPUS_STREAM": {
     "flags": [
      "COMPENSATE_STREAM_UNDERRUN_PTS"
     ],
     "gstPipeline": "appsrc name=stream-src ! opusparse ! opusdec ! {VOLUME_MASTER} ! {OPT_SPECTRUM} ! {SINK}",
     "streamMode": true
    },
    "PCM_STREAM": {
     "gstPipeline": "{STREAM_PIPELINE}",
     "streamMode": true
    },
    "PCM_STREAM_WITH_BUFFER": {
     "gstPipeline": "{STREAM_PIPELINE}",
     "gstProperties": {
      "MULTIQUEUE": {
       "": "multiqueue",
       "high-watermark": 0.5,
       "max-size-time": 1000000000,
       "use-buffering": "true"
      }
     },
     "streamMode": true
    },
    "RADIO": {
     "gstPipeline": "{MEDIA_PIPELINE}",
     "gstProperties": {
      "DECODEBIN": {
       "connection-speed": "200",
       "use-buffering": "true"
      },
      "SRC": "{SOUPHTTPSRC}"
     }
    },
    "TRACK": {
     "gstPipeline": "{MEDIA_PIPELINE}",
     "gstProperties": {
      "DECODEBIN": {
       "high-percent": "20",
       "low-percent": "2",
       "max-size-bytes": 0,
       "max-size-time": 15000000000,
       "use-buffering": "true"
      },
      "SOUPHTTPSRC": {
       "min-location-speed": "15000",
       "retries": "11",
       "timeout": "4"
      },
      "SRC": "{SOUPHTTPSRC}"
     }
    },
    "TRACK:CACHE": {
     "gstPipeline": "{MEDIA_PIPELINE}",
     "gstProperties": {
      "SRC": "{FILESRC}"
     }
    },
    "TRACK:TMS": {
     "gstPipeline": "{MEDIA_PIPELINE}",
     "gstProperties": {
      "DECODEBIN": {
       "use-buffering": "true"
      },
      "SRC": {
       "": "mediastreamsrc",
       "name": "yio_mediastreamsrc"
      }
     }
    },
    "common": {
     "deviceName": "default",
     "gstProperties": {
      "@yio_decodebin/GstHLSDemux": {
       "allow-extra-headers": false,
       "manifest-retries": "0",
       "manifest-timeout": "4"
      },
      "AUDIOCONVERT": "audioconvert name=yio_audioconvert",
      "AUDIORESAMPLE": "audioresample",
      "CAPS_STEREO": "audio/x-raw,rate=48000,channels=2,format=S16LE",
      "DECODEBIN": {
       "": "decodebin",
       "name": "yio_decodebin"
      },
      "DECRYPT": "{opt_aes_decoding}",
      "FILESRC": {
       "": "filesrc",
       "location": "{file_path}"
      },
      "MEDIA_PIPELINE": "{MEDIA_SRC} ! {DECODEBIN} ! {MONO_ATTENUATOR} ! {MEDIA_SINK}",
      "MEDIA_SINK": "{AUDIOCONVERT} ! {AUDIORESAMPLE} ! {SCALETEMPO} ! {CAPS_STEREO} ! {NORMALIZATION} ! {VOLUME_ALL} ! {SPECTRUM} ! {SINK}",
      "MEDIA_SRC": "{SRC} ! {DECRYPT}",
      "MONO_ATTENUATOR": {
       "": "identity",
       "name": "yio_mono_attenuator"
      },
      "MULTIQUEUE": "identity",
      "NORMALIZATION": "{opt_normalization}",
      "OPT_SPECTRUM": "{SPECTRUM}",
      "SCALETEMPO": "scaletempo",
      "SINK": "alsasink device={'deviceName'}",
      "SOUPHTTPSRC": {
       "": "souphttpsrc",
       "alt-locations": "{alt-uris}",
       "location": "{uri}",
       "max-http-range": "10485760",
       "name": "yio_souphttpsrc"
      },
      "SPECTRUM": "spectrum interval=40000000 bands=513 threshold=-80",
      "SRC": "@@UNDEFINED@@",
      "STREAM_PIPELINE": "appsrc name=stream-src format=time ! {input_media_type} ! {MULTIQUEUE} ! {AUDIORESAMPLE} ! {VOLUME_MASTER} ! {OPT_SPECTRUM} ! {SINK}",
      "VOLUME_ALL": "{VOLUME_MASTER} ! {VOLUME_FADING} ! {VOLUME_EQUALIZER}",
      "VOLUME_EQUALIZER": "volume name=equalizer-preamp ! equalizer-nbands name=equalizer",
      "VOLUME_FADING": "volume name=yio_fade",
      "VOLUME_MASTER": "volume name=volume0"
     }
    }
   },
   "volume": {}
  },
  "gogol": {
   "senderQueueSize": 30
  },
  "port": 9906
 },
