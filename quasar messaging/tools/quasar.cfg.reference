 "maind": {
  "Logging": {
   "file": {
    "enabled": true,
    "fileName": "${LOGS}/maind.log",
    "maxBackupIndex": 1,
    "maxFileSize": "110KB"
   },
   "level": "info",
   "moduleSinks": {
    "chip": {
     "file": {
      "enabled": true,
      "fileName": "${LOGS}/chip.log",
      "maxBackupIndex": 1,
      "maxFileSize": "110KB"
     }
    }
   }
  },
  "Minidump": {
   "enabled": true,
   "fileName": "minidump/maind.dmp",
   "moveToMetrica": true,
   "saveExceptionMessage": true,
   "sizeLimitKB": 200
  },
  "buttonsSettings": {
   "bluetoothMinTimeBetweenClicks": 50,
   "buttonNextPressTimeout": 1000,
   "buttonReleaseTimeout": 1000,
   "defaultNextPressThreshold": 60,
   "defaultTogglePressedThreshold": 200
  },
  "lastMonotonicClockFile": "${TMP}/power_off_timestamp",
  "powerOnMetricsSentOnceGuard": "${TMP}/device_power_on_metrica_guard",
  "selfDestroyer": {
   "memoryLimitRssKB": 69800
  },
  "versionsProviderSettings": {
   "cachedVerionFile": "${DATA}/data/version_cache.dat",
   "versionSendGuardFile": "${TMP}/version_state_sent"
  }
 },
 "matter": {
  "certStorePath": "${QUASAR}/matter/paa",
  "chipDbFileName": "${DATA}/data/matter/chip.lmdb",
  "devicesDbFileName": "${DATA}/data/matter/devices.lmdb",
  "enableCdTestKeySupport": true,
  "enableSystemDiscovery": true,
  "ota": {
   "availableUpdateTtlSec": 14400,
   "cleanupIntervalSec": 1800,
   "enabled": true,
   "otaDbFileName": "${DATA}/data/matter/ota.lmdb",
   "storagePath": "${DATA}/data/matter/ota_storage/",
   "storageSizeLimitKb": 6144,
   "storageTtlSec": 43200
  }
 },
 "mediad": {
  "Logging": {
   "file": {
    "enabled": true,
    "fileName": "${LOGS}/mediad.log",
    "maxBackupIndex": 1,
    "maxFileSize": "10KB"
   },
   "level": "info"
  },
  "Minidump": {
   "enabled": true,
   "fileName": "minidump/mediad.dmp",
   "moveToMetrica": true,
   "sizeLimitKB": 200
  },
  "ResolverCache": {
   "cacheLock": true,
   "enabled": true,
   "hosts": {
    "storage.mds.yandex.net": [
     "213.180.204.158",
     "2a02:6b8::158"
    ]
   }
  },
  "apiUrl": "wss://ws.api.music.yandex.net/quasar/websocket",
  "playbackParams": {
   "deviceName": "default",
   "gstPipeline": "souphttpsrc name=yio_souphttpsrc location={'uri'} ! {opt_aes_decoding} ! decodebin use-buffering=true ! audioconvert ! audioresample ! capsfilter name=capsfilter0 caps=\"audio/x-raw,rate=48000,channels=2,format=S16LE\" ! {opt_normalization} ! volume name=volume0 ! volume name=equalizer-preamp ! equalizer-nbands name=equalizer ! spectrum interval=40000000 bands=513 threshold=-80 ! alsasink device={deviceName}"
  },
  "port": 9900,
  "selfDestroyer": {
   "memoryLimitRssKB": 48800
  }
 },
 "memoryProfiling": {
  "maind": {
   "dumpFile": "${TMP}/memoryDumpFileMaind.prof",
   "enabled": true
  }
 },
 "metrica2d": {
  "port": 9904
 },
 "metricad": {
  "port": 9887
 },
 "monitord": {
  "disksList": [
   "ubi0_0",
   "ubi1_0"
  ],
  "metricsCollectorPeriodSec": 10,
  "metricsDumperPeriodSec": 300,
  "partitionsBlacklist": [
